{
  "name": "@samebase/identity-broker",
  "version": "0.1.0",
  "description": "An OpenID Provider for Convex that holds a team's upstream sign-in connections once and keeps no user accounts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/identity-broker.git",
    "directory": "packages/identity-broker"
  },
  "bin": {
    "identity-broker": "./dist/cli/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    }
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.build.json --force",
    "codegen": "convex codegen --component-dir ./src/component",
    "prepare": "pnpm run build",
    "prepack": "node -e \"const f=require('node:fs');f.copyFileSync('../../README.md','README.md');f.copyFileSync('../../LICENSE','LICENSE');f.copyFileSync('../../NOTICE','NOTICE')\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "catalog:",
    "oauth4webapi": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "convex": "catalog:",
    "convex-test": "catalog:",
    "openid-client": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "convex": "^1.47.0"
  }
}
