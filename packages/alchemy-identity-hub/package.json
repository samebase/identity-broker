{
  "name": "@samebase/alchemy-identity-hub",
  "version": "0.3.0",
  "description": "An Alchemy v2 resource that registers a Convex deployment as an OAuth client of an identity hub.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samebase/identity-broker.git",
    "directory": "packages/alchemy-identity-hub"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --build ./tsconfig.build.json --force",
    "prepare": "pnpm run build",
    "prepack": "node -e \"const f=require('node:fs');f.copyFileSync('../../LICENSE','LICENSE');f.copyFileSync('../../NOTICE','NOTICE')\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.5",
    "@effect/vitest": "4.0.5",
    "@types/node": "24.19.2",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.5",
    "typescript": "7.0.2",
    "vite-plus": "1.3.0"
  },
  "peerDependencies": {
    "alchemy": "2.0.0-beta.84",
    "effect": "^4.0.5"
  }
}
